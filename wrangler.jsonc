
{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
  "name": "miyuki-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miyuki-memory-2026",
      "database_id": "a13228eb-7a0e-4d32-a9b3-aee55d636072"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
